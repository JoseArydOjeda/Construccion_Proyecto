<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>


<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="sgt.proyecto.sgtuconstruccion.TurnosController"
            prefHeight="900"
            prefWidth="1400">
    <fx:define>
        <ToggleGroup fx:id="grpVentanillas"/>
    </fx:define>

    <center>
        <VBox spacing="15" BorderPane.alignment="CENTER">

            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <!-- VENTANILLAS -->

            <HBox spacing="20">

                <VBox HBox.hgrow="ALWAYS"
                      alignment="CENTER"
                      spacing="10"
                      style="-fx-background-color:white;
                             -fx-background-radius:12;
                             -fx-padding:20;
                             -fx-border-color:#D6D6D6;
                             -fx-border-radius:12;">

                    <Label text="V01">
                        <font>
                            <Font size="50"/>
                        </font>
                    </Label>

                    <Label fx:id="lblEstadoV1"
                           text="Estado: Libre"/>

                    <Label fx:id="lblTurnoV1"
                           text="Turno: Ninguno"/>

                    <RadioButton fx:id="rbV1"
                                 toggleGroup="$grpVentanillas"
                                 text="Seleccionar"/>
                </VBox>

                <VBox HBox.hgrow="ALWAYS"
                      alignment="CENTER"
                      spacing="10"
                      style="-fx-background-color:white;
                             -fx-background-radius:12;
                             -fx-padding:20;
                             -fx-border-color:#D6D6D6;
                             -fx-border-radius:12;">

                    <Label text="V02">
                        <font>
                            <Font size="50"/>
                        </font>
                    </Label>

                    <Label fx:id="lblEstadoV2"
                           text="Estado: Libre"/>

                    <Label fx:id="lblTurnoV2"
                           text="Turno: Ninguno"/>

                    <RadioButton fx:id="rbV2"
                                 toggleGroup="$grpVentanillas"
                                 text="Seleccionar"/>
                </VBox>

                <VBox HBox.hgrow="ALWAYS"
                      alignment="CENTER"
                      spacing="10"
                      style="-fx-background-color:white;
                             -fx-background-radius:12;
                             -fx-padding:20;
                             -fx-border-color:#D6D6D6;
                             -fx-border-radius:12;">

                    <Label text="V03">
                        <font>
                            <Font size="50"/>
                        </font>
                    </Label>

                    <Label fx:id="lblEstadoV3"
                           text="Estado: Libre"/>

                    <Label fx:id="lblTurnoV3"
                           text="Turno: Ninguno"/>

                    <RadioButton fx:id="rbV3"
                                 toggleGroup="$grpVentanillas"
                                 text="Seleccionar"/>
                </VBox>

            </HBox>

            <!-- CONTENIDO PRINCIPAL -->

            <HBox spacing="20">

                <VBox spacing="15" HBox.hgrow="ALWAYS">

                    <!-- Turnos en espera -->

                    <TitledPane text="Fila de Espera"
                                expanded="true">

                        <VBox spacing="10">

                            <TableView fx:id="tblEspera"
                                       prefHeight="250">

                                <columns>

                                    <TableColumn fx:id="colIdEspera"
                                                 text="ID"
                                                 prefWidth="100"/>

                                    <TableColumn fx:id="colFechaEspera"
                                                 text="Fecha / Hora"
                                                 prefWidth="220"/>

                                    <TableColumn fx:id="colSecuencia"
                                                 text="Secuencia"
                                                 prefWidth="120"/>

                                    <TableColumn fx:id="colEstadoEspera"
                                                 text="Estado"
                                                 prefWidth="150"/>

                                </columns>

                            </TableView>

                        </VBox>

                    </TitledPane>

                    <!-- Historial completo -->

                    <TitledPane text="Historial de Turnos"
                                expanded="true">

                        <VBox spacing="10">

                            <TableView fx:id="tblHistorial"
                                       prefHeight="350">

                                <columns>

                                    <TableColumn fx:id="colIdHistorial"
                                                 text="ID"
                                                 prefWidth="100"/>

                                    <TableColumn fx:id="colFechaHistorial"
                                                 text="Fecha / Hora"
                                                 prefWidth="220"/>

                                    <TableColumn fx:id="colEstadoHistorial"
                                                 text="Estado"
                                                 prefWidth="180"/>

                                    <TableColumn fx:id="colVentanilla"
                                                 text="Ventanilla"
                                                 prefWidth="150"/>

                                </columns>

                            </TableView>

                        </VBox>

                    </TitledPane>

                </VBox>

                <!-- PANEL LATERAL -->

                <VBox spacing="15"
                      prefWidth="280"
                      style="-fx-background-color:white;
                             -fx-background-radius:12;
                             -fx-padding:20;
                             -fx-border-color:#D6D6D6;
                             -fx-border-radius:12;">

                    <Label text="Acciones">

                        <font>
                            <Font size="18"/>
                        </font>

                    </Label>

                    <Button fx:id="btnRegistrarTurno"
                            text="Registrar Turno"
                            maxWidth="Infinity"
                            prefHeight="50"
                            onAction="#registrarTurno"/>

                    <Button fx:id="btnAsignar"
                            text="Solicitar Atención"
                            maxWidth="Infinity"
                            prefHeight="50"
                            onAction="#solicitarTurno"/>

                    <Button fx:id="btnFinalizar"
                            text="Finalizar Atención"
                            maxWidth="Infinity"
                            prefHeight="50"
                            disable="true"
                            onAction="#finalizarAtencion"/>

                    <Button fx:id="btnCancelar"
                            text="Cancelar Turno"
                            maxWidth="Infinity"
                            prefHeight="50"
                            onAction="#cancelarTurno"/>

                    <Separator />

                    <Label text="Mensajes del Sistema"/>

                    <TextArea fx:id="txtMensajes"
                              editable="false"
                              wrapText="true"
                              prefHeight="250"
                              promptText="Aquí aparecerán los mensajes de éxito y error..." />

                </VBox>

            </HBox>

        </VBox>
    </center>

</BorderPane>